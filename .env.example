PROJECT_NAME=FastAPI Enterprise Project
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2

# Use mysql+pymysql://... for MySQL or postgresql+psycopg://... for PostgreSQL.
DATABASE_URL=mysql+pymysql://name:password@hostname:port/databasename

SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# JSON object mapping webhook source names to HTTPS delivery endpoints.
WEBHOOK_URLS={}
WEBHOOK_SECRETS={"payment_gateway":"replace-with-payment-provider-secret"}
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
EXTERNAL_HEALTH_URL=